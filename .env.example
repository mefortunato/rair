# ==============================================================
# RAIR (Rogue Ascension: Idle Role-playing) - Environment Variables
# ==============================================================

# MongoDB Configuration
# Mapped to 27019 locally in docker-compose.yml to avoid collisions with default port 27017
MONGO_PORT=27019
MONGO_URI=mongodb://127.0.0.1:27019
DATABASE_NAME=rair_db

# Backend Configuration (FastAPI)
HOST=127.0.0.1
PORT=8001
SECRET_KEY=rair-cosmic-secret-key-2026

# Frontend Configuration (SvelteKit / Vite)
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
