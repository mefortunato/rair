# ==============================================================
# RAIR (Rogue Ascension: Idle Role-playing) - Environment Variables
# ==============================================================

# --------------------------------------------------------------
# 1. MongoDB Configuration
# --------------------------------------------------------------
# Mapped to 27017 locally in docker-compose.yml
# In production on GCP Cloud Run, replace with MongoDB Atlas or your hosted Mongo URI
MONGO_PORT=27017
MONGO_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=rair_db

# --------------------------------------------------------------
# 2. Application & Backend Configuration (FastAPI)
# --------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
SECRET_KEY=rair-cosmic-secret-key-2026
GOOGLE_CLIENT_ID=

# --------------------------------------------------------------
# 3. Frontend Configuration (SvelteKit / Vite)
# --------------------------------------------------------------
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173

# --------------------------------------------------------------
# 4. Google Cloud Run & GCP Deployment Configuration
# --------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_SERVICE_NAME=rair
GCP_ARTIFACT_REPO=rair-containers

# Cloud Run Resource Sizing & Scaling (defaults optimized for scale-to-zero)
CLOUD_RUN_CPU=1
CLOUD_RUN_MEMORY=512Mi
CLOUD_RUN_MIN_INSTANCES=0
CLOUD_RUN_MAX_INSTANCES=10
CLOUD_RUN_CONCURRENCY=80
